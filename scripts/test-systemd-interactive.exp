    eof { puts stderr "Rocky host shell exited during detached status"; exit 101 }
}
expect -re {\[ginux@ginux-rocky [^]]+\]\$ }
send -- "sudo sh -c 'i=0; while test \$i -lt 60; do grep -Fq \"GINUX_NATIVE_AUDIT:\" /var/lib/ginux/instances/rocky/audit.log && exit 0; i=\$((i+1)); sleep 1; done; exit 1' && printf 'GINUX_AUDIT_%s\\n' 'OPT_IN: PASS'\r"
expect {
    -re {GINUX_AUDIT_OPT_IN: PASS} {}
    timeout { puts stderr "--audit did not enable native syscall records"; exit 194 }
    eof { puts stderr "Rocky host shell exited during audit opt-in check"; exit 195 }
}
expect -re {\[ginux@ginux-rocky [^]]+\]\$ }
send -- "runtime=\$(sudo awk '{print \$1}' /var/lib/ginux/instances/rocky/runtime.pid); args=\$(ps -o args= -p \"\$runtime\"); case \"\$args\" in *' systemd') exit 1;; esac; sudo grep -Fq 'init = \"/sbin/init\"' /var/lib/ginux/instances/rocky/config.toml && sudo grep -Fq 'args = \[\"--system\", \"--unit=multi-user.target\"\]' /var/lib/ginux/instances/rocky/config.toml && printf 'GINUX_RUNTIME_%s\\n' 'CONFIG: PASS'\r"
expect {
