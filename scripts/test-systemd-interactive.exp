expect -re {\[ginux@ginux-rocky [^]]+\]\$ }
send -- "ginux start rocky --attach\r"
expect {
    -re {login:} {}
    timeout { puts stderr "relocked instance login timed out"; exit 223 }
    eof { puts stderr "Ginux exited before relocked login"; exit 224 }
}
send -- "root\r"
expect -re {Password:}
send -- "ginux\r"
expect {
    -re {\[root@ginux [^]]+\]# } {}
