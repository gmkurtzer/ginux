    eof { puts stderr "relocked instance shell exited early"; exit 226 }
}
send -- "if printf denied > /ginux-demo/read-only/maintenance 2>/dev/null; then printf 'GINUX_RELOCK_DENY: FAIL\\n'; else printf 'GINUX_RELOCK_DENY: PASS\\n'; fi\r"
expect {
    -re {GINUX_RELOCK_DENY: PASS} {}
    -re {GINUX_RELOCK_DENY: FAIL} { puts stderr "relocked contract allowed protected write"; exit 227 }
    timeout { puts stderr "relocked contract denial timed out"; exit 228 }
    eof { puts stderr "instance exited during relocked contract denial"; exit 229 }
}
expect -re {\[root@ginux [^]]+\]# }
send -- "kill -RTMIN+4 1\r"
expect {
    -re {rocky: stopped \(status 0\)} {}
