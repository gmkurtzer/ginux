#!/usr/bin/expect -f

if {$argc != 5} {
    puts stderr "usage: expect-systemd-login.exp <key> <port> <user> <domain-root> <log>"
    exit 64
}

set key [lindex $argv 0]
set port [lindex $argv 1]
set user [lindex $argv 2]
set domain_root [lindex $argv 3]
set log [lindex $argv 4]
set timeout 50

log_file -noappend $log
spawn ssh -tt -i $key -p $port -o BatchMode=yes -o ConnectTimeout=5 -o IdentitiesOnly=yes -o LogLevel=ERROR -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$user@127.0.0.1" "sudo /var/tmp/ginux native /var/tmp/gate9.toml $domain_root systemd"

expect {
    -re {login:} {}
    timeout { puts stderr "systemd login prompt timed out"; exit 70 }
    eof { puts stderr "systemd exited before login prompt"; exit 71 }
}
send -- "root\r"

expect {
    -re {Password:} {}
    timeout { puts stderr "systemd password prompt timed out"; exit 72 }
    eof { puts stderr "login exited before password prompt"; exit 73 }
}
send -- "ginux\r"

expect {
    -re {\[root@ginux [^]]+\]# } {}
    timeout { puts stderr "authenticated shell prompt timed out"; exit 74 }
    eof { puts stderr "login exited before authenticated shell"; exit 75 }
}
send -- "/usr/local/sbin/ginux-gate9-check\n"

expect {
    -re {GINUX_AUTHENTICATED} {}
    timeout { puts stderr "managed shell checks timed out"; exit 76 }
    eof { puts stderr "managed shell exited before checks completed"; exit 77 }
}
expect {
    -re {uid=0\(root\).*gid=0\(root\)} {}
    timeout { puts stderr "virtual root identity check timed out"; exit 80 }
    eof { puts stderr "managed shell exited before identity check"; exit 81 }
}
expect {
    -re {[0-9]+ \([^)]+\) [A-Z] [0-9]+} {}
    timeout { puts stderr "virtual proc stat check timed out"; exit 82 }
    eof { puts stderr "managed shell exited before proc check"; exit 83 }
}
expect {
    -re {GINUX_LOCKDOWN_HOST_PATHS: BLOCKED} {}
    timeout { puts stderr "host path lockdown check timed out"; exit 86 }
    eof { puts stderr "managed shell exited during host path check"; exit 87 }
}
expect {
    -re {GINUX_LOCKDOWN_DEVICES: BLOCKED} {}
    timeout { puts stderr "device lockdown check timed out"; exit 88 }
    eof { puts stderr "managed shell exited during device check"; exit 89 }
}
expect {
    -re {GINUX_LOCKDOWN_MOUNT: BLOCKED} {}
    timeout { puts stderr "mount lockdown check timed out"; exit 90 }
    eof { puts stderr "managed shell exited during mount check"; exit 91 }
}
expect {
    -re {GINUX_LOCKDOWN_NAMESPACE: BLOCKED} {}
    timeout { puts stderr "namespace lockdown check timed out"; exit 92 }
    eof { puts stderr "managed shell exited during namespace check"; exit 93 }
}
expect {
    -re {GINUX_NETWORK_DNS_HTTPS: PASS} {}
    timeout { puts stderr "shared network DNS/HTTPS check timed out"; exit 94 }
    eof { puts stderr "managed shell exited during network check"; exit 95 }
}
expect {
    -re {GINUX_NETWORK_BIND_ACCEPT_CONFLICT: PASS} {}
    timeout { puts stderr "shared network bind check timed out"; exit 96 }
    eof { puts stderr "managed shell exited during bind check"; exit 97 }
}
set timeout 900
expect {
    -re {GINUX_DNF_UPDATE: (PASS|SKIPPED)} {}
    timeout { puts stderr "dnf update timed out"; exit 98 }
    eof { puts stderr "managed shell exited during dnf update"; exit 99 }
}
expect {
    -re {GINUX_SHELL_CHECK_DONE} {}
    timeout { puts stderr "managed shell completion timed out"; exit 84 }
    eof { puts stderr "managed shell exited before checks completed"; exit 85 }
}
expect {
    -re {\[root@ginux [^]]+\]# } {}
    timeout { puts stderr "managed shell prompt did not return after checks"; exit 102 }
    eof { puts stderr "managed shell exited after checks"; exit 103 }
}
puts stderr "requesting controlled domain poweroff"
send -- "kill -RTMIN+4 1\n"
set timeout 120
expect {
    -re {translate surface=virtual-poweroff result=domain-shutdown} {}
    timeout { puts stderr "controlled domain poweroff timed out"; exit 78 }
    eof { puts stderr "domain exited without virtual poweroff evidence"; exit 79 }
}
expect {
    -re {GINUX_NATIVE_CHECK: PASS} {}
    timeout { puts stderr "clean domain shutdown result timed out"; exit 100 }
    eof { puts stderr "domain shutdown result missing"; exit 101 }
}
expect eof
exit 0
